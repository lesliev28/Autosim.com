<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AutoSim: Car Crash Simulation</title>
    <style>
        :root {
            --bg-dark: #0f172a;
            --card-bg: #1e293b;
            --accent-glow: #38bdf8;
            --critical-red: #ef4444;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
        }
        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: system-ui, -apple-system, sans-serif;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 1100px;
            margin: 0 auto;
        }
        header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 1px solid #334155;
            padding-bottom: 20px;
        }
        header h1 {
            letter-spacing: 2px;
            margin: 0 0 5px 0;
            color: var(--accent-glow);
        }
        .grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
        }
        @media (min-width: 768px) { .grid { grid-template-columns: 1fr 1.2fr; } }
        .card {
            background: var(--card-bg);
            border-radius: 12px;
            padding: 24px;
            border: 1px solid #334155;
        }
        h2 {
            font-size: 1.25rem;
            margin-top: 0;
            margin-bottom: 20px;
            border-left: 4px solid var(--accent-glow);
            padding-left: 10px;
        }
        .form-group { margin-bottom: 16px; }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }
        label {
            display: block;
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 6px;
            text-transform: uppercase;
        }
        input, select {
            width: 100%;
            box-sizing: border-box;
            background: #0f172a;
            border: 1px solid #475569;
            color: #fff;
            padding: 10px;
            border-radius: 6px;
            font-size: 1rem;
        }
        .btn-trigger {
            width: 100%;
            background: var(--accent-glow);
            color: #0f172a;
            font-weight: bold;
            border: none;
            padding: 14px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 1rem;
            text-transform: uppercase;
            margin-top: 10px;
        }
        .metrics-summary {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 25px;
        }
        .metric-box {
            background: #0f172a;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
            border: 1px solid #334155;
        }
        .metric-box .value { font-size: 1.5rem; font-weight: bold; }
        .metric-box .value.critical { color: var(--critical-red); }
        .injury-row { margin-bottom: 20px; }
        .progress-container {
            background: #0f172a;
            border-radius: 9999px;
            height: 12px;
            overflow: hidden;
            border: 1px solid #334155;
        }
        .progress-bar {
            background: linear-gradient(90deg, #eab308, var(--critical-red));
            width: 0%;
            height: 100%;
            transition: width 0.4s ease;
        }
        .notes {
            background: #1e293b;
            border-left: 4px solid #64748b;
            padding: 15px;
            font-size: 0.9rem;
            color: var(--text-muted);
            border-radius: 0 8px 8px 0;
            line-height: 1.4;
            margin-top: 25px;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>CRASH SIMULATOR</h1>
            <p>Biomechanical Injury Risk Assessment Engine</p>
        </header>
        <div class="grid">
            <div class="card">
                <h2>1. Telemetry Configuration</h2>
                <form id="simForm">
                    <div class="form-group">
                        <label>Biological Profile</label>
                        <select id="gender">
                            <option value="male">Male</option>
                            <option value="female">Female</option>
                        </select>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Height (cm)</label>
                            <input type="number" id="height" value="175">
                        </div>
                        <div class="form-group">
                            <label>Weight (kg)</label>
                            <input type="number" id="weight" value="75">
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Vehicle Make & Model</label>
                        <input type="text" id="carModel" value="Standard Sedan">
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Model Year</label>
                            <input type="number" id="carYear" value="2018">
                        </div>
                        <div class="form-group">
                            <label>Impact Speed (km/h)</label>
                            <input type="number" id="speed" value="50">
                        </div>
                    </div>
                    <button type="submit" class="btn-trigger">Run Impact Telemetry</button>
                </form>
            </div>
            <div class="card">
                <h2>2. Impact Diagnostics</h2>
                <div class="metrics-summary">
                    <div class="metric-box">
                        <label>Kinetic Energy</label>
                        <span class="value" id="energyValue">0.00 kJ</span>
                    </div>
                    <div class="metric-box">
                        <label>Severe Injury Risk</label>
                        <span class="value critical" id="overallRisk">0%</span>
                    </div>
                </div>
                <h3>Injury Breakdown</h3>
                <div class="injury-row">
                    <label>Head & Neck Strain</label>
                    <div class="progress-container"><div class="progress-bar" id="barHead"></div></div>
                    <div id="txtHead" style="text-align:right; font-weight:bold;">0%</div>
                </div>
                <div class="injury-row">
                    <label>Thoracic / Chest Compression</label>
                    <div class="progress-container"><div class="progress-bar" id="barChest"></div></div>
                    <div id="txtChest" style="text-align:right; font-weight:bold;">0%</div>
                </div>
                <div class="injury-row">
                    <label>Pelvic & Lower Extremity Fracture</label>
                    <div class="progress-container"><div class="progress-bar" id="barPelvis"></div></div>
                    <div id="txtPelvis" style="text-align:right; font-weight:bold;">0%</div>
                </div>
                <div class="notes" id="simulationNotes">Configure metrics above to view calculation breakdown.</div>
            </div>
        </div>
    </div>
    <script>
        document.getElementById('simForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const gender = document.getElementById('gender').value;
            const height = parseFloat(document.getElementById('height').value);
            const weight = parseFloat(document.getElementById('weight').value);
            const carModel = document.getElementById('carModel').value;
            const carYear = parseInt(document.getElementById('carYear').value);
            const speedKmh = parseFloat(document.getElementById('speed').value);

            const speedMs = speedKmh * (1000 / 3600);
            const totalMass = weight + 1500;
            const kineticEnergyKj = (0.5 * totalMass * Math.pow(speedMs, 2)) / 1000;

            let baseRisk = Math.min(100, Math.pow(speedKmh / 95, 2.5) * 100);
            let yearModifier = carYear < 1990 ? 1.5 : carYear < 2000 ? 1.3 : carYear < 2010 ? 1.15 : carYear >= 2020 ? 0.85 : 1.0;

            let headMod = 1.0, chestMod = 1.0, pelvisMod = 1.0;
            if (gender === 'female') { headMod *= 1.15; chestMod *= 1.10; }
            if (height < 160) headMod *= 1.1;
            else if (height > 190) pelvisMod *= 1.15;
            if (weight > 100) chestMod *= 1.2;

            let head = Math.min(100, Math.round(baseRisk * yearModifier * headMod));
            let chest = Math.min(100, Math.round(baseRisk * yearModifier * chestMod));
            let pelvis = Math.min(100, Math.round(baseRisk * yearModifier * pelvisMod));
            let overall = Math.min(100, Math.round((head * 0.4) + (chest * 0.4) + (pelvis * 0.2)));

            document.getElementById('energyValue').innerText = `${kineticEnergyKj.toFixed(2)} kJ`;
            document.getElementById('overallRisk').innerText = `${overall}%`;
            
            document.getElementById('barHead').style.width = head + '%';
            document.getElementById('txtHead').innerText = head + '%';
            document.getElementById('barChest').style.width = chest + '%';
            document.getElementById('txtChest').innerText = chest + '%';
            document.getElementById('barPelvis').style.width = pelvis + '%';
            document.getElementById('txtPelvis').innerText = pelvis + '%';

